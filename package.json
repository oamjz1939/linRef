{
  "name": "linref",
  "version": "1.1.0",
  "description": "Lightweight reference image viewer for artists (PureRef alternative)",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev:vite": "vite --port 5173",
    "build:electron": "node scripts/ensure-electron.cjs && tsc -p tsconfig.electron.json",
    "build": "tsc -b && vite build && npm run build:electron",
    "electron": "npm run build:electron && electron .",
    "start": "npm run build && electron .",
    "icon:gen": "/Users/paranim/my-file-with-nooo-sync/my-software-requirment/venvs/quickcmd/bin/python scripts/generate-icons.py",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "dist": "npm run build && electron-builder",
    "version:bump": "python3 bump_version_script.py",
    "test": "vitest run"
  },
  "build": {
    "appId": "com.linref.app",
    "productName": "linRef",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/icons/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "assets/icons/icon.icns",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.graphics-design",
      "identity": null
    },
    "dmg": {
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 410,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 190,
          "type": "file"
        }
      ]
    },
    "win": {
      "icon": "assets/icons/icon.ico",
      "target": [
        "nsis"
      ]
    }
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "konva": "^9.3.18",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^26.18.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
